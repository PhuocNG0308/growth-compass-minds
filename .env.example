PORT=8080
DATABASE_URL=postgres://user:pass@localhost:5432/growth

# 64 ky tu hex. Sinh bang:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/youtube/callback

# Tu sinh, giong lenh tren:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Minds KHÔNG cấp token này. Đặt vào 2 chỗ: biến môi trường dưới đây, và My Connections
# trên trang profile Minds (thao tác tay — không có API để đẩy tự động).
GROWTH_API_TOKEN=

# URL cong khai cua Growth API — Mind goi vao day, nen KHONG the la localhost.
# Khi dev, mo tunnel bang ngrok static domain (URL giu nguyen qua moi lan restart):
#   ngrok http 8080 --domain=<domain>.ngrok-free.app
PUBLIC_BASE_URL=

MINDS_BUILDER_API_KEY=
MIND_CONVERSATION_ALIAS=growth
CHECKPOINT_POLL_MS=60000
MIND_ID=

# on | off — off drops the write scope and hides the reply box
YOUTUBE_REPLIES=on

# on | off — bat "xem thu bang du lieu mau" tren man hinh dang nhap.
# Can chay `npm run seed:demo` truoc. Bi ep ve off khi NODE_ENV=production.
DEMO_MODE=off

# Kenh that ma du lieu mau soi theo. Doc hoan toan cong khai, khong can key.
DEMO_SOURCE_CHANNEL=@HardwareHaven

# Kenh phat 24/7 cho dai "dang live". De trong thi tat han dai do.
DEMO_LIVE_CHANNEL=@LofiGirl

# Tuy chon. CHI doc cong khai: binh luan that, so binh luan, tin nhan live chat.
# KHONG mo duoc CTR / impressions / giu chan — Analytics API chi tra loi chu kenh.
# Tao tai https://console.cloud.google.com/apis/credentials (bat YouTube Data API v3).
YOUTUBE_API_KEY=
